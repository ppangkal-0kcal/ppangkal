PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/ppangkal
JWT_SECRET=change-me-to-a-long-random-string

# 한국관광공사 TourAPI (국문 관광정보 서비스_GW) — 공공데이터포털에서 발급, 필수
TOUR_API_SERVICE_KEY=
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2

# Cloudflare R2 (S3 호환 오브젝트 스토리지) — bread_items.image_url 채우는 관리자용
# 업로드 스크립트(prisma/scripts/uploadBreadImages.ts)에서 사용. R2 대시보드 > Manage R2 API
# Tokens에서 발급.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ppangkal-images
# 버킷 Public Access 활성화 시 나오는 pub-xxxx.r2.dev 주소, 또는 연결한 커스텀 도메인
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
# 무료 티어(저장 10GB/월) 안전장치 — 실제 한도보다 낮게 잡은 마진. 넘으면 업로드 자체를 거부한다.
R2_MAX_STORAGE_GB=9
R2_MAX_FILE_SIZE_MB=10

